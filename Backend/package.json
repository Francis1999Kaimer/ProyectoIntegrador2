{
  "name": "aiblocks-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:baseline": "node scripts/baseline.cjs",
    "prisma:status": "prisma migrate status",
    "prisma:deploy": "prisma migrate deploy",
    "test": "node --test test/*.test.cjs",
    "test:repositories:db": "node scripts/repositories-smoke.cjs",
    "prebuild": "npm run prisma:generate",
    "pretest": "npm run build",
    "auth:seed-demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/auth-demo.ps1 -Action seed",
    "auth:test-demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/auth-demo.ps1 -Action test",
    "test:apis:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/auth-demo.ps1 -Action apis"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/node": "22.18.6",
    "prisma": "6.19.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  }
}
