# AI Blocks Studio — plantilla de configuración; copiar a un .env PRIVADO.
# No poner contraseñas reales en GitHub.
# Los valores siguientes son ejemplos, NO credenciales operativas.

# Backend NestJS / Prisma (hitos 2 y 3)
BACKEND_PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aiblockstudio
DB_USER=app_user
DB_PASSWORD=REEMPLAZAR_EN_ENV_PRIVADO
# Prisma usa DATABASE_URL; si la contraseña tiene caracteres especiales, codificarla para URL.
DATABASE_URL="mysql://app_user:REEMPLAZAR_EN_ENV_PRIVADO@127.0.0.1:3306/aiblockstudio"
JWT_SECRET=GENERAR_UN_SECRETO_ALEATORIO_FUERTE
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173

# Frontend Vite (definir en Frontend/.env al habilitar integración)
VITE_API_URL=http://localhost:3000/api

# Docker Compose opcional (perfil db-container: MariaDB escucha en host puerto 3307)
MARIADB_DOCKER_PORT=3307
MARIADB_ROOT_PASSWORD=CAMBIAR_SOLO_EN_ENV_PRIVADO
MARIADB_APP_USER=app_user
MARIADB_APP_PASSWORD=CAMBIAR_SOLO_EN_ENV_PRIVADO

# Servicios auxiliares FUTUROS (perfil extras)
REDIS_URL=redis://127.0.0.1:6379
MINIO_ROOT_USER=CAMBIAR_SOLO_EN_ENV_PRIVADO
MINIO_ROOT_PASSWORD=CAMBIAR_SOLO_EN_ENV_PRIVADO
MINIO_ENDPOINT=http://127.0.0.1:9000
